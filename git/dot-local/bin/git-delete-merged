#!/usr/bin/env bash

set -euo pipefail

# Deletes all local branches that are merged into the given branch (defaulting to the default branch)
# Branches checked out in any worktree (including this one) are skipped. See git-show-merged for detection.
remote="${1:-origin}"
default_branch="${2:-$(git default-branch "$remote")}"

while read -r branch; do
  worktree="$(git for-each-ref "refs/heads/$branch" --format='%(worktreepath)')"
  if [[ -n "$worktree" ]]; then
    echo "Skipping '$branch': checked out at $worktree" >&2
    continue
  fi
  # Rebased and squashed branches aren't ancestors of the default branch, so -d would refuse them
  git branch -D "$branch"
done < <(git show-merged "$remote" "$default_branch")
